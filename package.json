{
  "name": "@estate/android-mcp",
  "version": "1.14.4",
  "mcpName": "io.github.estate/android-mcp",
  "description": "Android MCP server (hard-fork merge of us-all/android-mcp) — ADB device/UI/app control with device profiles (Hisense TV, Pixel 9 Pro XL)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "android-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "overrides": {
      "hono": "^4.12.25",
      "@hono/node-server": ">=1.19.13",
      "fast-uri": "^3.1.2",
      "ip-address": "^10.1.1",
      "fast-xml-builder": "^1.1.7"
    },
    "supportedArchitectures": {
      "os": [
        "current",
        "linux",
        "darwin"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ],
      "libc": [
        "current",
        "glibc",
        "musl"
      ]
    },
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/ui','dist/ui',{recursive:true})\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "presmoke": "pnpm run build",
    "smoke": "node scripts/smoke-test.mjs",
    "pretoken-stats": "pnpm run build",
    "token-stats": "node scripts/measure-tokens.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@us-all/mcp-toolkit": "^1.3.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.7.0",
    "sharp": "^0.35.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.1"
  },
  "keywords": [
    "mcp",
    "android",
    "adb",
    "model-context-protocol",
    "claude",
    "automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toxicwind/android-tv-mcp"
  },
  "homepage": "https://github.com/toxicwind/android-tv-mcp#readme",
  "bugs": {
    "url": "https://github.com/toxicwind/android-tv-mcp/issues"
  }
}
